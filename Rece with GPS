#include <SPI.h>
#include <LoRa.h>
#include "mbedtls/aes.h"
#include <HardwareSerial.h>
#include <DFRobotDFPlayerMini.h>

// --- HARDWARE PIN CONFIGURATION (XIAO ESP32-S3) ---
const int csPin       = D3;
const int resetPin    = D1;
const int irqPin      = D2;
const int statusLED   = LED_BUILTIN;

// --- RF CONFIGURATION (Updated to SF10 for -132 dBm sensitivity) ---
const long BANDWIDTH_FREQ = 433E6;
const int SYNC_WORD       = 0x22;

// --- SECURITY & DECRYPTION CONFIG ---
const unsigned char aes_key[16] = {
  0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6,
  0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C
};

uint32_t lastReceivedCounter = 0;
HardwareSerial mySerial1(1);
DFRobotDFPlayerMini myDFPlayer;

void processEncryptedPacket(const uint8_t* ciphertext, int rssi) {
  uint8_t decrypted[16] = {0};

  // 1. Airwave Ciphertext Monitor
  Serial.print("\n[RAW AIRWAVE CIPHERTEXT]: ");
  for (int i = 0; i < 16; i++) {
    Serial.printf("%02X ", ciphertext[i]);
  }
  Serial.println();

  // 2. Hardware AES-128 Decryption
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_dec(&aes, aes_key, 128);
  mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, ciphertext, decrypted);
  mbedtls_aes_free(&aes);

  // 3. Unpack Command Byte & Sequence Counter
  uint8_t commandID = decrypted[0];
  uint32_t incomingCounter = ((uint32_t)decrypted[1] << 24) |
                             ((uint32_t)decrypted[2] << 16) |
                             ((uint32_t)decrypted[3] << 8)  |
                             ((uint32_t)decrypted[4]);

  // INTEGRITY GUARD 1: Drop corrupted packets with invalid command IDs
  if (commandID < 1 || commandID > 5) {
    Serial.printf("[CORRUPT PACKET REJECTED] Invalid Command ID: %u | RSSI: %d dBm\n", commandID, rssi);
    return;
  }

  // INTEGRITY GUARD 2: Transmitter reboot auto-synchronization
  if (lastReceivedCounter > 1000000 || (incomingCounter == 1 && lastReceivedCounter > 5) || (incomingCounter < lastReceivedCounter && (lastReceivedCounter - incomingCounter > 3))) {
    lastReceivedCounter = 0;
  }

  // INTEGRITY GUARD 3: Anti-replay protection
  if (incomingCounter <= lastReceivedCounter && lastReceivedCounter != 0) {
    Serial.printf("[SECURITY REJECT] Old/Replayed Packet Detected! (#%u <= #%u) | RSSI: %d dBm\n", 
                  incomingCounter, lastReceivedCounter, rssi);
    return;
  }

  lastReceivedCounter = incomingCounter;

  // 4. Unpack Verified GPS Coordinates (Bytes 5 to 13)
  int32_t latFixed = ((int32_t)decrypted[5] << 24) |
                     ((int32_t)decrypted[6] << 16) |
                     ((int32_t)decrypted[7] << 8)  |
                     ((int32_t)decrypted[8]);

  int32_t lngFixed = ((int32_t)decrypted[9] << 24) |
                     ((int32_t)decrypted[10] << 16) |
                     ((int32_t)decrypted[11] << 8)  |
                     ((int32_t)decrypted[12]);

  uint8_t sats = decrypted[13];

  float latitude  = latFixed / 1000000.0f;
  float longitude = lngFixed / 1000000.0f;

  // 5. Trigger Audio Playback
  myDFPlayer.play(commandID);

  // 6. Print Decrypted Intent & Location Telemetry
  Serial.println("----------------------------------------");
  Serial.printf("[RX DECRYPTED #%u] RSSI: %d dBm\n", incomingCounter, rssi);

  switch (commandID) {
    case 1:
      Serial.println("***************************");
      Serial.println(">>> SOURCE: THROAT <<<");
      Serial.println(">>> DETECTED: SINGLE SWALLOW (MOVE) <<<");
      Serial.println("***************************");
      break;

    case 2:
      Serial.println("!!!!!!!!!!!!!!!!!!!!!!!!!!!");
      Serial.println(">>> SOURCE: THROAT <<<");
      Serial.println(">>> DETECTED: DOUBLE SWALLOW (DON'T MOVE) <<<");
      Serial.println("!!!!!!!!!!!!!!!!!!!!!!!!!!!");
      break;

    case 3:
      Serial.println("---------------------------");
      Serial.println(">>> SOURCE: JAW <<<");
      Serial.println(">>> DETECTED: SINGLE JAW CLENCH <<<");
      Serial.println("---------------------------");
      break;

    case 4:
      Serial.println("===========================");
      Serial.println(">>> SOURCE: JAW <<<");
      Serial.println(">>> DETECTED: DOUBLE JAW CLENCH <<<");
      Serial.println("===========================");
      break;

    case 5:
      Serial.println("#################################");
      Serial.println(">>> SOURCE: JAW <<<");
      Serial.println(">>> DETECTED: LONG CLENCH (HELP) <<<");
      Serial.println("#################################");
      break;
  }

  // Display Operator Positioning
  Serial.println("--- OPERATOR POSITION (GPS) ---");
  Serial.printf("Satellites Locked: %u\n", sats);
  if (latFixed == 0 && lngFixed == 0) {
    Serial.println("Position: SEARCHING FOR SATELLITES (No Accurate Fix Yet)");
  } else {
    Serial.printf("Latitude : %.6f\n", latitude);
    Serial.printf("Longitude: %.6f\n", longitude);
    Serial.printf("Maps URL : https://maps.google.com/?q=%.6f,%.6f\n", latitude, longitude);
  }
  Serial.println("----------------------------------------");
}

void setup() {
  Serial.begin(115200);
  
  // DFPlayer UART Init (RX = D7, TX = D6)
  mySerial1.begin(9600, SERIAL_8N1, D7, D6);
  delay(500);

  pinMode(statusLED, OUTPUT);
  digitalWrite(statusLED, HIGH);

  lastReceivedCounter = 0;

  // Hardware Reset LoRa Module
  pinMode(resetPin, OUTPUT);
  digitalWrite(resetPin, LOW);
  delay(100);
  digitalWrite(resetPin, HIGH);
  delay(100);

  LoRa.setPins(csPin, resetPin, irqPin);

  if (!LoRa.begin(BANDWIDTH_FREQ)) {
    Serial.println("FATAL: Receiver LoRa Init Failed! Check SPI Connections.");
    while (1) {
      digitalWrite(statusLED, LOW);  delay(50);
      digitalWrite(statusLED, HIGH); delay(50);
    }
  }

  // Updated Spreading Factor 10 (SF10) to match Transmitter
  LoRa.setSyncWord(SYNC_WORD);                  
  LoRa.setSpreadingFactor(10);            
  LoRa.setSignalBandwidth(125E3);        
  LoRa.setCodingRate4(5);                

  if (!myDFPlayer.begin(mySerial1)) {
    Serial.println("[DFPLAYER WARNING] Module not responding or SD card missing.");
  } else {
    myDFPlayer.volume(30);
  }

  Serial.println(">>> RECEIVER NODE ARMED: LISTENING FOR 5-INTENT + GPS TRANSMISSIONS <<<");
}

void loop() {
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    if (packetSize == 16) {
      uint8_t ciphertext[16];
      for (int i = 0; i < 16; i++) {
        ciphertext[i] = LoRa.read();
      }
      
      digitalWrite(statusLED, LOW);
      processEncryptedPacket(ciphertext, LoRa.packetRssi());
      digitalWrite(statusLED, HIGH);
    } else {
      while (LoRa.available()) LoRa.read();
    }
  }
}
