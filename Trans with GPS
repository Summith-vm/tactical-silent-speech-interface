#include <SPI.h>
#include <LoRa.h>
#include "mbedtls/aes.h"
#include <TinyGPSPlus.h>
#include <HardwareSerial.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// --- HARDWARE PIN CONFIGURATION (XIAO ESP32-S3) ---
const int bioAmpPin   = D0;          
const int csPin       = D3;          
const int resetPin    = D1;          
const int irqPin      = -1;          
const int statusLED   = LED_BUILTIN; 

// --- I2C PINS (MPU6050 & LCD SHARED BUS) ---
const int sdaPin      = D2;
const int sclPin      = D6;
const int MPU_ADDR    = 0x68; 
int16_t AcX, AcY, AcZ, Tmp, GyX, GyY, GyZ;

// --- LCD CONFIGURATION ---
LiquidCrystal_I2C lcd(0x27, 16, 2); 

// --- GPS CONFIGURATION (GY-NEO6MV2) ---
TinyGPSPlus gps;
HardwareSerial gpsSerial(1); // UART1: D7 = RX, D6 is SCL

// --- RF & HARDWARE ENCRYPTION CONFIGURATION ---
const long BANDWIDTH_FREQ = 433E6;   
const int SYNC_WORD       = 0x22;    

// 32-byte (256-bit) Key for AES-256
const unsigned char aes_key[32] = {
  0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6,
  0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C,
  0x4A, 0x92, 0x6C, 0x1B, 0x8A, 0x33, 0xD4, 0x5F,
  0xE3, 0x71, 0x90, 0x22, 0xBB, 0x14, 0x8C, 0x55
};

uint32_t packetCounter = 0;

// --- HARDENED NOISE & DETECTION PARAMETERS ---
float filteredEnergy = 0.0f;
const float smoothing = 0.04f; 

const int NOISE_DEADZONE        = 22000; 
const int TRIGGER_LIMIT         = 14000; 
const int JAW_TRIGGER_LIMIT     = 36000; 
const unsigned long MIN_GESTURE_DURATION = 80; 

// --- TIMING WINDOWS ---
const unsigned long DOUBLE_TAP_WINDOW  = 1600; 
const unsigned long LONG_HOLD_MIN_MS   = 1800; 

// --- STATE TRACKING ---
bool isActuated = false;
bool isJawPeak = false;
bool longActionFired = false;
unsigned long actuationStartTime = 0;

int swallowTapCount = 0;
unsigned long lastSwallowTime = 0;
bool waitingSwallow = false;

int jawTapCount = 0;
unsigned long lastJawTime = 0;
bool waitingJaw = false;

void feedGPS() {
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }
}

void setupMPU() {
  Wire.begin(sdaPin, sclPin);
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); 
  Wire.write(0);    
  if(Wire.endTransmission(true) == 0) {
    Serial.println(">>> MPU6050 IMU DETECTED & INITIALIZED ON D2/D6 <<<");
  } else {
    Serial.println("!!! WARNING: MPU6050 NOT DETECTED ON D2/D6 I2C BUS !!!");
  }
}

void readMPU() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B); 
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 14, true); 
  
  if (Wire.available() == 14) {
    AcX = Wire.read() << 8 | Wire.read(); 
    AcY = Wire.read() << 8 | Wire.read(); 
    AcZ = Wire.read() << 8 | Wire.read(); 
    Tmp = Wire.read() << 8 | Wire.read(); 
    GyX = Wire.read() << 8 | Wire.read(); 
    GyY = Wire.read() << 8 | Wire.read(); 
    GyZ = Wire.read() << 8 | Wire.read(); 
  }
}

void sendEncryptedIntent(uint8_t commandID) {
  uint8_t plaintext[16] = {0};
  uint8_t ciphertext[16] = {0};

  plaintext[0] = commandID; 
  
  packetCounter++;
  plaintext[1] = (packetCounter >> 24) & 0xFF;
  plaintext[2] = (packetCounter >> 16) & 0xFF;
  plaintext[3] = (packetCounter >> 8)  & 0xFF;
  plaintext[4] = packetCounter & 0xFF;

  int32_t latFixed = 0;
  int32_t lngFixed = 0;
  uint8_t sats = (uint8_t)gps.satellites.value();

  if (gps.location.isValid() && (gps.location.age() < 10000)) {
    latFixed = (int32_t)(gps.location.lat() * 1000000.0);
    lngFixed = (int32_t)(gps.location.lng() * 1000000.0);
  }

  plaintext[5] = (latFixed >> 24) & 0xFF;
  plaintext[6] = (latFixed >> 16) & 0xFF;
  plaintext[7] = (latFixed >> 8)  & 0xFF;
  plaintext[8] = latFixed & 0xFF;

  plaintext[9]  = (lngFixed >> 24) & 0xFF;
  plaintext[10] = (lngFixed >> 16) & 0xFF;
  plaintext[11] = (lngFixed >> 8)  & 0xFF;
  plaintext[12] = lngFixed & 0xFF;

  plaintext[13] = sats;
  plaintext[14] = esp_random() & 0xFF;
  plaintext[15] = esp_random() & 0xFF;

  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_enc(&aes, aes_key, 256); 
  mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_ENCRYPT, plaintext, ciphertext);
  mbedtls_aes_free(&aes);

  digitalWrite(statusLED, LOW); 

  unsigned long txStartTime = millis(); 

  LoRa.beginPacket();
  LoRa.write(ciphertext, 16);
  LoRa.endPacket();

  digitalWrite(statusLED, HIGH);

  Serial.printf("\n[TX #%u] PACKET SENT (Cmd %u | Sats: %u): ", packetCounter, commandID, sats);
  for (int i = 0; i < 16; i++) {
    Serial.printf("%02X ", ciphertext[i]);
  }
  Serial.println();

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Sent Cmd ");
  lcd.print(commandID);
  lcd.setCursor(0, 1);
  lcd.print("Waiting for ACK.");

  Serial.println("[WAITING FOR ACK] Listening for Receiver confirmation...");
  bool gotAck = false;

  while (millis() - txStartTime < 1500) {
    int packetSize = LoRa.parsePacket();
    if (packetSize == 16) {
      uint8_t ackCiphertext[16];
      for (int i = 0; i < 16; i++) {
        ackCiphertext[i] = LoRa.read();
      }

      uint8_t ackPlaintext[16] = {0};
      mbedtls_aes_context aes_dec;
      mbedtls_aes_init(&aes_dec);
      mbedtls_aes_setkey_dec(&aes_dec, aes_key, 256);
      mbedtls_aes_crypt_ecb(&aes_dec, MBEDTLS_AES_DECRYPT, ackCiphertext, ackPlaintext);
      mbedtls_aes_free(&aes_dec);

      if (ackPlaintext[0] == 0xAA) {
        uint32_t ackCounter = ((uint32_t)ackPlaintext[1] << 24) |
                              ((uint32_t)ackPlaintext[2] << 16) |
                              ((uint32_t)ackPlaintext[3] << 8)  |
                              ((uint32_t)ackPlaintext[4]);

        if (ackCounter == packetCounter) {
          unsigned long rtt = millis() - txStartTime;
          uint8_t echoedCommand = ackPlaintext[5];
          unsigned long oneWayLatency = (rtt - 50) / 2;

          Serial.println("\n>>>>>>>>>> [SUCCESS] VALID ACK RECEIVED! <<<<<<<<<<");
          Serial.printf("Transmitted Command : %u\n", commandID);
          Serial.printf("Receiver Echoed     : %u (PERFECT MATCH!)\n", echoedCommand);
          Serial.printf("Round Trip Time     : %lu ms\n", rtt);
          Serial.printf("One-Way Latency     : ~%lu ms\n", oneWayLatency);
          Serial.println(">>>>>>>>>>>>>>>>>>>>>>>>><<<<<<<<<<<<<<<<<<<<<<<<<<\n");

          // DISPLAY LATENCY METRICS ON LCD
          lcd.clear();
          lcd.setCursor(0, 0);
          lcd.print("RTT: ");
          lcd.print(rtt);
          lcd.print("ms");

          lcd.setCursor(0, 1);
          lcd.print("1-Way: ");
          lcd.print(oneWayLatency);
          lcd.print("ms");

          gotAck = true;
          delay(1500); // HELD STRICTLY FOR 1.5 SECONDS
          break; 
        }
      }
    }
    delay(1);
  }

  if (!gotAck) {
    Serial.println("!!!!!!!!!! [WARNING] ACK TIMEOUT (Packet may be lost) !!!!!!!!!!");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ACK TIMEOUT!");
    lcd.setCursor(0, 1);
    lcd.print("Packet Lost");
    delay(1500);
  }

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("TX ARMED & READY");
  lcd.setCursor(0, 1);
  lcd.print("Waiting Gesture");
}

void setup() {
  Serial.begin(115200);
  
  pinMode(statusLED, OUTPUT);
  digitalWrite(statusLED, HIGH);
  
  analogReadResolution(12);

  Wire.begin(sdaPin, sclPin);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("TX BOOTING...");
  delay(500);

  gpsSerial.begin(9600, SERIAL_8N1, D7, -1);
  setupMPU();

  pinMode(resetPin, OUTPUT);
  digitalWrite(resetPin, LOW);
  delay(100);
  digitalWrite(resetPin, HIGH);
  delay(100);

  LoRa.setPins(csPin, resetPin, irqPin);

  if (!LoRa.begin(BANDWIDTH_FREQ)) {
    Serial.println("FATAL: LoRa Init Failed! Check SPI Connections.");
    lcd.clear();
    lcd.print("LORA SPI FAILED!");
    while (1);
  }

  LoRa.setTxPower(20, PA_OUTPUT_PA_BOOST_PIN); 
  LoRa.setSyncWord(SYNC_WORD);                  
  LoRa.setSpreadingFactor(10);           
  LoRa.setSignalBandwidth(125E3);        
  LoRa.setCodingRate4(5);               

  long initSum = 0;
  for (int i = 0; i < 80; i++) {
    int val = analogRead(bioAmpPin);
    initSum += abs(val - 2048);
    delay(2);
    feedGPS();
  }
  filteredEnergy = (initSum / 80.0f / 10.0f) * 15.0f;

  Serial.println(">>> TRANSMITTER READY: D2/D6 I2C FUSION + GPS + ACK LCD ARMED <<<");

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("TX ARMED & READY");
  lcd.setCursor(0, 1);
  lcd.print("Waiting Gesture");
}

void loop() {
  feedGPS();
  readMPU();

  bool motionArtifactActive = false;
  if (abs(GyX) > 15000 || abs(GyY) > 15000 || abs(GyZ) > 15000) {
    motionArtifactActive = true;
  }

  long burstSum = 0;
  int rawCenter = 2048; 

  for (int i = 0; i < 60; i++) {
    int val = analogRead(bioAmpPin);
    burstSum += abs(val - rawCenter); 
    delayMicroseconds(300);
    if (i == 30) feedGPS();
  }

  float currentEnergy = (burstSum / 10.0f) * 15.0f; 
  filteredEnergy = (smoothing * currentEnergy) + ((1.0f - smoothing) * filteredEnergy);
  float netSignal = currentEnergy - filteredEnergy;
  float tacticalSignal = (netSignal < NOISE_DEADZONE) ? 0.0f : (netSignal - NOISE_DEADZONE);

  if (motionArtifactActive) {
    tacticalSignal = 0.0f;
    Serial.println("[ARTIFACT CANCELED] Bio-Spike rejected due to Head Movement!");
  }

  Serial.print("Baseline:");
  Serial.print(filteredEnergy);
  Serial.print(",");
  Serial.print("Tactical_Signal:");
  Serial.print(tacticalSignal);
  Serial.print(",");
  Serial.print("Trigger_Limit:");
  Serial.println(TRIGGER_LIMIT);

  unsigned long now = millis();

  if (!isActuated && tacticalSignal > TRIGGER_LIMIT) {
    isActuated = true;
    actuationStartTime = now;
    longActionFired = false;
    isJawPeak = false;
  }

  if (isActuated) {
    if (tacticalSignal >= JAW_TRIGGER_LIMIT) {
      isJawPeak = true;
    }

    if (isJawPeak && !longActionFired && (tacticalSignal >= JAW_TRIGGER_LIMIT * 0.5f)) {
      unsigned long holdDuration = now - actuationStartTime;
      if (holdDuration >= LONG_HOLD_MIN_MS) {
        Serial.println("\n#################################");
        Serial.println(">>> DETECTED: LONG CLENCH (HELP) <<<");
        Serial.println("#################################\n");
        
        sendEncryptedIntent(5); 
        longActionFired = true;

        jawTapCount = 0;
        waitingJaw = false;
        swallowTapCount = 0;
        waitingSwallow = false;
      }
    }
  }

  float releaseThreshold = TRIGGER_LIMIT * 0.35f;
  if (isActuated && tacticalSignal < releaseThreshold) {
    isActuated = false;
    unsigned long pulseDuration = now - actuationStartTime;

    if (!longActionFired && pulseDuration >= MIN_GESTURE_DURATION && pulseDuration < LONG_HOLD_MIN_MS) {
      if (isJawPeak) {
        jawTapCount++;
        lastJawTime = now;
        waitingJaw = true;

        if (jawTapCount >= 2) {
          Serial.println("\n===========================");
          Serial.println(">>> DETECTED: DOUBLE JAW CLENCH <<<");
          Serial.println("===========================\n");
          sendEncryptedIntent(4); 
          jawTapCount = 0;
          waitingJaw = false;
        }
      } else {
        swallowTapCount++;
        lastSwallowTime = now;
        waitingSwallow = true;

        if (swallowTapCount >= 2) {
          Serial.println("\n!!!!!!!!!!!!!!!!!!!!!!!!!!!");
          Serial.println(">>> DETECTED: DOUBLE SWALLOW <<<");
          Serial.println("!!!!!!!!!!!!!!!!!!!!!!!!!!!\n");
          sendEncryptedIntent(2); 
          swallowTapCount = 0;
          waitingSwallow = false;
        }
      }
    }
  }

  if (waitingSwallow && (now - lastSwallowTime > DOUBLE_TAP_WINDOW)) {
    if (swallowTapCount == 1 && !isActuated) {
      Serial.println("\n***************************");
      Serial.println(">>> DETECTED: SINGLE SWALLOW <<<");
      Serial.println("***************************\n");
      sendEncryptedIntent(1); 
    }
    swallowTapCount = 0;
    waitingSwallow = false;
  }

  if (waitingJaw && (now - lastJawTime > DOUBLE_TAP_WINDOW)) {
    if (jawTapCount == 1 && !isActuated) {
      Serial.println("\n---------------------------");
      Serial.println(">>> DETECTED: SINGLE JAW CLENCH <<<");
      Serial.println("---------------------------\n");
      sendEncryptedIntent(3); 
    }
    jawTapCount = 0;
    waitingJaw = false;
  }

  feedGPS();
  delay(10);
}
